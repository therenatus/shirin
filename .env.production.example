# Copy to .env.production (never commit it) and fill in real values.
# Generate secrets with: openssl rand -base64 48

DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public URLs (behind your HTTPS reverse proxy)
CORS_ORIGINS=https://admin.example.kg
ADMIN_API_URL=https://api.example.kg/api/v1
S3_PUBLIC_URL=https://files.example.kg
S3_ACCESS_KEY=
S3_SECRET_KEY=

# First administrator (logs in by SMS to this number)
ADMIN_PHONE=+996XXXXXXXXX

# SMS (SMSPRO / Nikita); sender name must be approved by the provider
SMS_PROVIDER=nikita
SMS_NIKITA_LOGIN=
SMS_NIKITA_PASSWORD=
SMS_NIKITA_SENDER=
SMS_DAILY_LIMIT=3000

# Reverse proxies in front of the API (1 for a single nginx)
TRUST_PROXY=1

# Shown in the privacy policy for data requests
PRIVACY_CONTACT_EMAIL=

# Push notifications (optional): base64 of the Firebase service account JSON
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Alerts to a Telegram chat: create a bot with @BotFather, add it to a group,
# put the bot token and the group's chat id here
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Database backups: daily at BACKUP_HOUR (Bishkek time), kept BACKUP_KEEP_DAYS
# days in BACKUP_DIR on this server. Copy that folder off the server too.
BACKUP_DIR=./backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
# Optional: URL pinged after each successful backup (e.g. healthchecks.io),
# so you are alerted when backups stop
BACKUP_PING_URL=
