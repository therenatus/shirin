# Copy to .env.production (never commit it) and fill in real values.
# Generate secrets with: openssl rand -base64 48

DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public URLs (behind your HTTPS reverse proxy)
CORS_ORIGINS=https://admin.example.kg
ADMIN_API_URL=https://api.example.kg/api/v1
S3_PUBLIC_URL=https://files.example.kg
S3_ACCESS_KEY=
S3_SECRET_KEY=

# First administrator (logs in by SMS to this number)
ADMIN_PHONE=+996XXXXXXXXX

# SMS (SMSPRO / Nikita); sender name must be approved by the provider
SMS_PROVIDER=nikita
SMS_NIKITA_LOGIN=
SMS_NIKITA_PASSWORD=
SMS_NIKITA_SENDER=
SMS_DAILY_LIMIT=3000

# Reverse proxies in front of the API (1 for a single nginx)
TRUST_PROXY=1

# Shown in the privacy policy for data requests
PRIVACY_CONTACT_EMAIL=
