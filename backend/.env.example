NODE_ENV=development
DATABASE_URL=postgresql://shirin_user:password@localhost:5432/shirin_db
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# S3-compatible storage (SeaweedFS in docker-compose)
S3_ENDPOINT=localhost
S3_PORT=8333
S3_ACCESS_KEY=shirin_dev_access_key
S3_SECRET_KEY=shirin_dev_secret_key
S3_USE_SSL=false
S3_BUCKET=shirin
# Base URL clients use to download public files
S3_PUBLIC_URL=http://localhost:8333
REDIS_HOST=localhost
REDIS_PORT=6379

# SMS: SMS_PROVIDER=stub sends nothing and always uses code 9999
# (default outside production; refused in production).
# SMS_PROVIDER=nikita sends through SMSPRO (smspro.nikita.kg); the sender
# name must be approved by the provider. Check the request format in
# src/sms/nikita.provider.ts against the API spec from your account.
SMS_PROVIDER=stub
SMS_NIKITA_LOGIN=
SMS_NIKITA_PASSWORD=
SMS_NIKITA_SENDER=SHIRIN
# SMS_NIKITA_URL=https://smspro.nikita.kg/api/message
# SMS_NIKITA_TEST=true
# Max login SMS per day for the whole system (protects the SMS budget)
SMS_DAILY_LIMIT=3000

# Number of reverse proxies in front of the API (nginx = 1), for rate limits
TRUST_PROXY=0

# Push notifications: Firebase service account JSON, base64-encoded
# (Firebase console > Project settings > Service accounts > Generate key;
#  then: base64 -i key.json). Without it notifications are only stored.
FIREBASE_SERVICE_ACCOUNT_BASE64=
